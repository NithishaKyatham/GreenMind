# ==========================================================
# GreenMind - Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# ==========================================================

# ---------- Database ----------
# Production/staging (PostgreSQL):
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgresql+psycopg2://greenmind_user:replace_with_a_strong_database_password@localhost:5432/greenmind_db
# Local dev fallback (SQLite) - used automatically if USE_SQLITE=true
USE_SQLITE=false
SQLITE_PATH=./greenmind_dev.db

# ---------- Auth / Security ----------
JWT_SECRET=change_this_to_a_long_random_secret_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Weather API ----------
# Uses OpenWeatherMap (https://openweathermap.org/api) by default.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ---------- AI Assistant (chatbot) ----------
# Optional: if you want GreenMind Assistant backed by an LLM API.
# If left blank, the chatbot falls back to a rule-based agricultural
# knowledge-base responder (clearly labeled as such in the UI).
AI_API_KEY=
AI_API_PROVIDER=anthropic

# ---------- ML Model ----------
MODEL_PATH=../ml/models/crop_disease_model.pt
MODEL_ARCHITECTURE=efficientnet_b0
MODEL_INPUT_SIZE=224
# If true and no trained model file exists at MODEL_PATH, backend starts
# in DEVELOPMENT FALLBACK mode (clearly labeled to the user as demo mode).
ALLOW_MODEL_FALLBACK=true
# Predictions below this confidence (0.0-1.0) are reported as
# "unable to confidently identify" instead of a specific diagnosis.
CONFIDENCE_THRESHOLD=0.60

# ---------- App ----------
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=8

# ---------- Frontend (Vite reads VITE_ prefixed vars only) ----------
VITE_API_BASE_URL=http://localhost:8000/api
